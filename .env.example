# ============================================================
# MODÈLE des variables d'environnement du projet (DEV local)
# ------------------------------------------------------------
# Utilisation : copier ce fichier en « .env » puis adapter les
# valeurs si besoin. Le fichier .env est ignoré par Git
# (jamais de secret en dur dans le code).
# Ces variables servent à docker-compose.yml (PostgreSQL + Mosquitto).
# ============================================================

# --- Base de données PostgreSQL (conteneur Docker) ---
POSTGRES_USER=ocp
POSTGRES_PASSWORD=ocp_dev_password
POSTGRES_DB=ocp_diagnostic
POSTGRES_PORT=5432

# --- Broker MQTT Mosquitto (conteneur Docker) ---
MQTT_PORT=1883
