# ============================================================
# MODÈLE des variables d'environnement du BACKEND (DEV local)
# ------------------------------------------------------------
# Copier ce fichier en « backend/.env », puis adapter si besoin.
# Le fichier .env est ignoré par Git.
#
# Le backend doit être lancé DEPUIS le dossier backend/
# pour que ce fichier soit trouvé automatiquement.
# ============================================================

# Nom et version affichés par l'API
APP_NAME=OCP Motor Diagnostic — Backend
APP_VERSION=0.1.0

# --- Persistance ---
# "memory" : stockage en mémoire (dev rapide, réinitialisé au redémarrage)
# "sql"    : PostgreSQL (Docker requis, voir docker-compose.yml)
STORAGE_BACKEND=memory

# --- Connexion à la base PostgreSQL (utilisée si STORAGE_BACKEND=sql) ---
DATABASE_URL=postgresql+psycopg://ocp:ocp_dev_password@localhost:5432/ocp_diagnostic

# --- Broker MQTT Mosquitto (utilisé à partir de l'Étape 7) ---
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
